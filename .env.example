# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.
#
# This file is for LOCAL dev only. Production values (Render) are set via
# the render.yaml Blueprint prompts / Render dashboard, never committed --
# see README.md "Part 11: Deployment" for the full runbook.

# Must match docker-compose.yml's `db` service (user/password/db name) unless you
# change both. Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://kelly_user:kelly_password@localhost:5432/kelly_poker

# Comma-separated list of origins allowed to call this API from a browser.
# The React dev server (Part 10) runs on localhost:3000 by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secret used to sign JWTs. MUST be overridden with a long random value
# outside of local dev -- generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
