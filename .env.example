# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Must match docker-compose.yml's `db` service (user/password/db name) unless you
# change both. Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://kelly_user:kelly_password@localhost:5432/kelly_poker

# Comma-separated list of origins allowed to call this API from a browser.
# The React dev server (Part 10) runs on localhost:3000 by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000
